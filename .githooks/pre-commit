#!/bin/bash
#
# Formats staged sources before they are committed.
#
# Rust: generated mirrors are skipped. api_gen emits them without a formatter
# pass and CI's `cargo regen-check` compares the committed output byte for
# byte, so a rustfmt pass there fails the build. rustfmt's `ignore` option is
# nightly-only and this project is on stable.
#
# C: tools/scripts/format.sh does the work and owns the exclusion list.

set -e

cd "$(git rev-parse --show-toplevel)"

mapfile -t staged < <(
    git diff --cached --name-only --diff-filter=ACM \
        | grep -E '\.(rs|c|cpp|h|hpp)$' \
        || true
)

if [ ${#staged[@]} -eq 0 ]; then
    exit 0
fi

# A file staged with unstaged edits on top (as `git add -p` leaves it) would
# get those edits swept into the commit by the `git add` below, so refuse.
mapfile -t partial < <(git diff --name-only -- "${staged[@]}")

if [ ${#partial[@]} -gt 0 ]; then
    echo "pre-commit: staged with unstaged changes on top, refusing to reformat:" >&2
    printf '  %s\n' "${partial[@]}" >&2
    echo >&2
    echo "Format them by hand and re-stage, or stage the rest." >&2
    exit 1
fi

mapfile -t rs < <(printf '%s\n' "${staged[@]}" | grep '\.rs$' | grep -v '/generated/' || true)

if [ ${#rs[@]} -gt 0 ]; then
    # rustfmt follows `mod` declarations, so formatting a crate root also
    # formats the generated tree (rust/flowi/src/lib.rs reaches all of it), and
    # stable rustfmt has no --skip-children. Record which generated files were
    # already dirty, then restore only the ones rustfmt touched. Files that
    # were dirty beforehand (an unstaged `cargo regen` run) are left alone.
    gen_dirty() { git diff --name-only | grep '/generated/' | sort; }

    before="$(gen_dirty)"
    rustfmt --edition 2021 "${rs[@]}"
    comm -13 <(echo "$before") <(gen_dirty) | tr '\n' '\0' | xargs -0 -r git checkout --
fi

if printf '%s\n' "${staged[@]}" | grep -qE '\.(c|cpp|h|hpp)$'; then
    tools/scripts/format.sh staged >/dev/null
fi

# Re-add only the staged paths to pick up the formatters' edits. The
# partial-stage check above means these paths have no other worktree changes.
git add -- "${staged[@]}"
