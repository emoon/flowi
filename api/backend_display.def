#[module(platform)]

/// Software-render framebuffer view - the CPU-visible pixel surface a backend
/// hands back from get_framebuffer. Backend-owned; valid until the next present.
struct DisplayFramebuffer {
    /// Backing pixel memory (backend-owned).
    pixels: *void,
    width: i32,
    height: i32,
    /// Bytes per row.
    pitch: i32,
    /// Pixel format (e.g. RGB24, RGBA8888).
    format: u32,
}

/// A rectangle on the display plane, in display pixels.
struct DisplayRect {
    x: i32,
    y: i32,
    width: i32,
    height: i32,
}

/// Display configuration passed to a backend factory.
struct DisplayConfig {
    /// Rendering resolution (e.g. 1920x1080).
    logical_width: i32,
    logical_height: i32,
    /// Window/screen size (SDL only).
    display_width: i32,
    display_height: i32,
    /// Pixel-perfect scaling.
    integer_scaling: bool,
    /// Start in fullscreen mode (SDL only).
    start_fullscreen: bool,
    /// Make the window floating - bypasses tiling WMs (SDL only).
    floating_window: bool,
    /// Disable vsync (capture mode - run as fast as possible).
    disable_vsync: bool,
    /// Render the UI framebuffer at the live window-pixel size instead of at a
    /// fixed logical size scaled to fit (SDL only). Maps the UI texture 1:1 to the
    /// window and makes get_window_size report the live pixel size. Pair with
    /// resize(). Off by default.
    native_pixel_size: bool,
    window_title: *const char,
}

/// Frame-capture callback (for screen recording) - invoked with the captured
/// frame buffer; user_data is the caller's opaque pointer.
callback DisplayFrameCaptureCallback(buffer: *const u8, width: i32, height: i32, user_data: *void)

/// Display backend interface for window management, framebuffer access, and
/// display-plane operations. Instance-based over an opaque ctx passed to every
/// function. Input and audio are separate backends.
struct DisplayBackend {
    /// Backend-private state, passed back to every function-field.
    ctx: *void,

    /// Tear the backend down and free ctx.
    destroy(ctx: *void),

    /// Current window size in pixels.
    get_window_size(ctx: *void, width: *i32, height: *i32),
    /// Whether the window has been asked to close.
    should_close(ctx: *void) -> bool,
    /// Whether the window currently has focus.
    is_focused(ctx: *void) -> bool,

    /// Resize the UI framebuffer to a new pixel size (native_pixel_size mode) so
    /// the next frame renders 1:1 at the new size. Optional: null means the backend
    /// has no resizable framebuffer. Call this when get_window_size changes.
    resize(ctx: *void, width: i32, height: i32),

    /// Fractional per-monitor content scale (physical px / logical px) for this
    /// window's display. Optional: null means the backend reports no scale (treated
    /// as 1.0).
    get_content_scale(ctx: *void) -> f32,

    /// Acquire the software-render framebuffer for this frame.
    get_framebuffer(ctx: *void) -> DisplayFramebuffer,
    /// Present the current frame.
    present(ctx: *void),

    /// Place the display plane (a video plane, separate from the UI framebuffer).
    set_display_rect(ctx: *void, rect: DisplayRect),
    /// Upload pixels to the display plane.
    upload_display(ctx: *void, pixels: *const void, width: i32, height: i32, pitch: i32),
    /// Enable/disable the display plane.
    set_display_enabled(ctx: *void, enabled: bool),
    /// Set the display-plane alpha.
    set_display_alpha(ctx: *void, alpha: u8),
    /// Set the UI alpha.
    set_ui_alpha(ctx: *void, alpha: u8),

    /// Install a frame-capture callback (optional - for screen recording).
    set_frame_capture_callback(ctx: *void, callback: DisplayFrameCaptureCallback, user_data: *void),
}
