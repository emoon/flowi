/// The ids of the selected rows of a list.
///
/// You own the set. Pass it to `List::begin` and the list updates it.
#[attributes(Opaque)]
struct SelectionSet {}

/// Stores the ids of the selected rows.
///
/// Pass a set to `List::begin` and the list updates it. Check a row with `SelectionSet::contains` and read the
/// whole selection with `SelectionSet::copy_ids`.
api SelectionSet {
    /// Creates an empty set.
    ///
    /// `initial_capacity` is the number of ids to make room for. 0 uses a default.
    [manual] create(initial_capacity: u32) -> *SelectionSet
    /// Destroys the set. Does nothing for a null set.
    [drop] destroy(set: *SelectionSet)
    /// Returns whether `id` is selected.
    [const] contains(set: *SelectionSet, id: u64) -> bool
    /// Selects `id` if `selected` is true, and deselects it otherwise.
    set(set: *SelectionSet, id: u64, selected: bool)
    /// Deselects every id.
    [rename(clear)] clear_all(set: *SelectionSet)
    /// Replaces the selection with exactly the `count` ids at `ids`.
    set_all(set: *SelectionSet, [slice(u64)] ids: *const u64, count: u64)
    /// Applies `SelectionRequest` values to the set, in order.
    ///
    /// `ordered_ids` holds the ids of all `id_count` rows in display order. `SelectionRequestKind::SetRange` and
    /// `SelectionRequestKind::SetAll` use it to find their rows. It can be null if neither is in `reqs`. A range
    /// with an end that is not in `ordered_ids` changes nothing.
    [manual] apply(set: *SelectionSet, [slice(SelectionRequest)] reqs: *const SelectionRequest, req_count: u64, [slice(u64)] ordered_ids: *const u64, id_count: u64)
    /// Returns the number of selected ids.
    [manual] len(set: *SelectionSet) -> u64
    /// Writes the selected ids into `out` and returns how many it wrote.
    ///
    /// It writes at most `cap` ids, in no particular order. Compare the result with `SelectionSet::len` to see if
    /// `out` was big enough.
    [const] copy_ids(set: *SelectionSet, [slice_mut(u64)] out: *u64, cap: u64) -> u64
}
