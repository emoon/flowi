#[module(ui)]

/// A copy of the rendered frame, for smoke tests and screenshots.
///
/// This is filled by `App::read_pixels` and `Host::read_pixels`. Rows are tightly packed, so `stride` is
/// `width` times the number of channels and there is no padding between rows.
struct PixelReadback {
    /// The first pixel. The renderer owns it, and it stays valid until the next frame or readback.
    ///
    /// The pixels are 8 bits per channel in the renderer's own layout: RGB for the software renderer and RGBA for
    /// the GPU renderer.
    pixels: *void,
    /// The width in pixels.
    width: u32,
    /// The height in pixels.
    height: u32,
    /// The number of bytes per row.
    stride: u32,
}
