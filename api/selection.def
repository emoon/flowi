/// What a `SelectionRequest` asks for.
///
/// The kind decides which of the other fields of the request are read.
enum SelectionRequestKind {
    /// Deselect every row. No other field is read.
    ClearAll = 0,
    /// Select every row, or deselect every row, depending on `SelectionRequest.selected`. No row id is read.
    SetAll,
    /// Select or deselect the row `SelectionRequest.id`.
    SetOne,
    /// Select or deselect all rows from `SelectionRequest.id` to `SelectionRequest.to_id`, both included. The two
    /// ids can come in either order.
    SetRange,
}

/// One change to the selection, reported by a list.
///
/// A list reports the changes made this frame, not the selection itself. Apply them to a `SelectionSet` with
/// `SelectionSet::apply`, or to a selection you keep yourself.
#[attributes(Copy)]
struct SelectionRequest {
    /// What the request asks for.
    kind: SelectionRequestKind,
    /// Whether to select the rows (true) or deselect them (false). `SelectionRequestKind::ClearAll` ignores it.
    selected: bool,
    /// The row to change for `SelectionRequestKind::SetOne`, or the first row of the span for
    /// `SelectionRequestKind::SetRange`.
    id: u64,
    /// The last row of the span for `SelectionRequestKind::SetRange`.
    to_id: u64,
}
