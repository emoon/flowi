/// A gap, padding or margin size, in logical pixels.
enum Spacing {
    None = 0,
    /// Extra small.
    XS = 4,
    /// Small.
    SM = 8,
    /// Medium.
    MD = 16,
    /// Large.
    LG = 24,
    /// Extra large.
    XL = 32,
}

/// A corner radius, in logical pixels.
enum Radius {
    /// Square corners.
    None = 0,
    /// Small.
    SM = 4,
    /// Medium.
    MD = 8,
    /// Large.
    LG = 12,
    /// Extra large.
    XL = 16,
    /// Fully rounded ends, for pills and circles.
    Full = 999,
}

/// A widget height, in logical pixels.
enum WidgetHeight {
    /// Small.
    SM = 44,
    /// Medium.
    MD = 60,
    /// Large.
    LG = 80,
}

/// A border width, in logical pixels.
enum BorderWidth {
    None = 0,
    /// Thin.
    Thin = 1,
    /// Medium.
    Medium = 2,
    /// Thick.
    Thick = 4,
}
