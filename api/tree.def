/// A row of a tree, as shown on screen.
///
/// Pass every visible row to `Tree::begin`, top to bottom, and leave out the rows under a collapsed row.
#[attributes(Copy)]
struct TreeRow {
    /// The id of the row (unique, never 0).
    id: u64,
    /// The nesting depth (0 for a top-level row).
    depth: u16,
    /// Whether the row gets an expand arrow.
    has_children: bool,
    /// Whether the row is expanded. Its children are then the next rows in the slice.
    expanded: bool,
}

/// An expanded node of a virtual tree.
///
/// Pass only the expanded nodes to `Tree::begin_virtual`, in the order they appear on screen, so a node always
/// comes after its parent.
#[attributes(Copy)]
struct TreeExpanded {
    /// The index of the parent's entry in this slice (-1 for a top-level row).
    parent: i32,
    /// Which child of the parent this node is, counted from 0.
    child_index: u32,
    /// The number of children the node has.
    child_count: u32,
}

/// A row of a virtual tree, returned by `Tree::row_at`.
#[attributes(Copy)]
struct TreeVirtualRow {
    /// The index of the parent's entry in your expanded slice (-1 for a top-level row).
    parent: i32,
    /// Which child of the parent this row is, counted from 0.
    child_index: u32,
    /// The nesting depth (0 for a top-level row).
    depth: u16,
    /// The index of the row's own entry in your expanded slice (-1 if the row is not expanded).
    node: i32,
}

/// Options for `Tree::begin` and `Tree::begin_virtual`.
///
/// A field left at zero uses its default.
#[attributes(Copy)]
struct TreeConfig {
    /// The row height, gap, scrollbar and type-ahead labels, as for a List (one label per row).
    list: ListConfig,
    /// The indent of each nesting level, in logical pixels (0 uses 16). The arrow is this wide too.
    indent: f32,
}

/// The outcome of a tree for one frame, returned by `Tree::end`.
#[attributes(Copy)]
struct TreeResult {
    /// The selection, activation and focus, as for a List. The drag fields stay empty.
    list: ListResult,
    /// The row the user asked to expand or collapse (0 for none).
    ///
    /// The Tree does not remember which rows are expanded. Change your own data and pass the new rows next
    /// frame.
    toggled_id: u64,
    /// Whether the row should expand (true) or collapse (false).
    toggle_expanded: bool,
    /// The row number of that row this frame. Only read it when `toggled_id` is not 0.
    toggled_row: u32,
}

/// A tree view over rows you own.
///
/// Each frame, call `Tree::begin` with the visible rows. For each row in the range it returns, call
/// `Tree::item_begin`, draw the row, and call `Tree::item_end`. Then call `Tree::end`, and expand or collapse
/// the row in `TreeResult.toggled_id` in your own data.
///
/// The Tree draws the indent and the arrows. Selection and the keyboard work as in a List. Right expands a
/// row or moves to its first child, and Left collapses a row or moves to its parent. Rows stay selected while
/// a collapsed parent hides them, and rows cannot be dragged.
#[frame_context]
api Tree {
    /// Starts a tree and returns the range of rows to draw.
    ///
    /// `rows` holds the `count` visible rows. Selection goes into `set`. If `set` is null, read the changes
    /// from `ListResult.requests` and draw your own highlight.
    [manual] begin(id: LayoutId, rows: *const TreeRow, count: u32, set: *SelectionSet, config: TreeConfig) -> ListRange
    /// Starts the row at index `row` and returns the `Signal` for it.
    ///
    /// The indent and the arrow are drawn for you, and what you draw before `Tree::item_end` goes to the right
    /// of them. A press on the arrow is not a click on the row.
    item_begin(row: u32) -> Signal
    /// Starts a tree that can hold millions of rows, and returns the range of rows to draw.
    ///
    /// `root_count` is the number of top-level rows and `expanded` holds the `count` expanded nodes. For each
    /// row in the range, call `Tree::row_at` to find out which child it is, then `Tree::item_begin_virtual`
    /// and `Tree::item_end`.
    ///
    /// Rows have no ids of their own. The id of a row is its row number plus one, in `set` and in the result.
    /// When you apply a toggle on the next frame, the Tree moves the cursor and the selection in `set` along
    /// with the rows below it, and unselects the rows a collapse hid. If the number of rows changes for any
    /// other reason, the selection is cleared. With a null `set` you have to do the same yourself.
    ///
    /// Right can ask you to expand a row that has no children. Ignore that request. Type-ahead is off and
    /// `ListConfig.labels` is not read. A tree shows at most 2^31 - 1 rows nested 65535 levels deep.
    [manual] begin_virtual(id: LayoutId, root_count: u32, expanded: *const TreeExpanded, count: u32, set: *SelectionSet, config: TreeConfig) -> ListRange
    /// Returns which child a row of a virtual tree is, so you know what to draw.
    ///
    /// Call this between `Tree::begin_virtual` and `Tree::end`.
    row_at(row: u32) -> TreeVirtualRow
    /// Starts a row of a virtual tree, like `Tree::item_begin`.
    ///
    /// Pass true for `has_children` to give the row an arrow.
    item_begin_virtual(row: u32, has_children: bool) -> Signal
    /// Ends the row started with `Tree::item_begin` or `Tree::item_begin_virtual`.
    item_end()
    /// Ends the tree and returns the result for this frame.
    [manual] end() -> TreeResult
}
