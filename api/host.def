#[module(app)]

extern opaque FlArena

/// The settings for `Host::create`.
struct HostSettings {
    /// The render width in pixels (above 0). The host opens its window at this size and renders every frame into it.
    render_width: i32,
    /// The render height in pixels (above 0).
    render_height: i32,
    /// Whether the working directory of the process is mounted as the default asset mount.
    ///
    /// Paths given to `Font::load` and `Image::load` are then looked up against it. Leave it false if you mount your
    /// own data directory and load through `Font::load_mount`.
    mount_working_directory: bool,
}

/// A flowi host that you drive yourself.
///
/// Returned by `Host::create` and freed with `Host::destroy`.
#[attributes(Opaque)]
struct Host {}

/// A flowi host for a program that owns its own display, input and presentation.
///
/// Use it instead of `App` when flowi should not open the window. `Host::create` brings up the renderer, the
/// resource systems and a UI context. Each frame, push the input you decoded, call `Host::frame_begin`, emit the UI
/// and call `Host::frame_end`. Then call `Host::read_pixels` to get the result. Call `Host::destroy` when you are
/// done.
api Host {
    /// Creates a host that allocates from `arena` and returns it, or null if it could not be created.
    ///
    /// The reason is logged. The host never frees `arena`, so keep it alive until after `Host::destroy`.
    [manual] create(arena: *FlArena, settings: *const HostSettings) -> *Host
    /// Destroys the host and releases everything it owns, its window included.
    ///
    /// Does nothing if `host` is null.
    [manual] destroy(host: *Host)

    /// Opens a frame.
    ///
    /// The input pushed since the last call becomes the input of this frame. `delta_time` is the time since the
    /// last frame, in seconds. Emit the UI after this call, then call `Host::frame_end`.
    [manual] frame_begin(host: *Host, delta_time: f64)
    /// Closes the frame opened by `Host::frame_begin` and renders it.
    [manual] frame_end(host: *Host)

    /// Fills `out` with the pixels of the last rendered frame and returns true.
    ///
    /// The format is RGB24 for the software renderer and RGBA8 for the GPU. Returns false if the render backend
    /// cannot read its pixels back.
    [manual] read_pixels(host: *Host, out: *PixelReadback) -> bool
}
