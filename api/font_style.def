/// A font weight, used to register and choose fonts with `Font::style_register` and `Font::style_set`.
enum FontStyle {
    /// Regular weight (the default).
    Default = 0,
    /// Bold weight.
    Bold = 1,
    /// Thin weight.
    Thin = 2,
    /// Light weight.
    Light = 3,
    /// The number of styles. It is not a style.
    Count = 4,
}
