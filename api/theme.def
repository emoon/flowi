/// The colors for interactive widgets such as buttons, toggles and sliders.
struct ThemeInteractive {
    /// The accent color of buttons, slider fills and checkmarks.
    base: Color,
    /// The color while the mouse is over the widget.
    hover: Color,
    /// The color while the widget is pressed.
    press: Color,
    /// The color of the keyboard focus ring.
    focus: Color,
    /// The color of a disabled widget.
    disabled: Color,
}

/// The background colors of the UI layers.
struct ThemeSurface {
    /// The window background.
    base: Color,
    /// The background of cards, buttons and inputs, which sit above `ThemeSurface.base`.
    elevated: Color,
    /// The backdrop behind modals, popups and dropdowns.
    overlay: Color,
    /// The highlight of a selected item.
    selected: Color,
}

/// The colors of borders and dividers.
struct ThemeBorder {
    /// The border around inputs and cards.
    default_color: Color,
    /// The border color that marks focus, such as on the cursor row of a list.
    focus: Color,
    /// The color of divider lines.
    separator: Color,
}

/// The text colors.
struct ThemeText {
    /// The color of main text.
    primary: Color,
    /// The color of labels, hints and other less important text.
    secondary: Color,
    /// The color of links and highlighted text.
    accent: Color,
}

/// The colors that report the outcome of an action.
struct ThemeFeedback {
    /// Success and confirmation.
    success: Color,
    /// Cautions and issues that do not block the user.
    warning: Color,
    /// Errors and destructive actions.
    error: Color,
    /// Neutral information.
    info: Color,
}

/// The colors flowi uses when it paints widgets, in groups.
///
/// Pass it to `Theme::update` to set the base palette. `Theme::colors` returns the palette in use.
struct ThemeColors {
    interactive: ThemeInteractive,
    surface: ThemeSurface,
    border: ThemeBorder,
    text: ThemeText,
    feedback: ThemeFeedback,
}

/// A flag for one color of `ThemeColors`, used in `ThemeOverride.slots`.
///
/// Combine flags with a bitwise OR. The flags follow the order of the fields in `ThemeColors`.
enum ThemeSlot {
    InteractiveBase = 1,
    InteractiveHover = 2,
    InteractivePress = 4,
    InteractiveFocus = 8,
    InteractiveDisabled = 16,
    SurfaceBase = 32,
    SurfaceElevated = 64,
    SurfaceOverlay = 128,
    SurfaceSelected = 256,
    BorderDefault = 512,
    BorderFocus = 1024,
    BorderSeparator = 2048,
    TextPrimary = 4096,
    TextSecondary = 8192,
    TextAccent = 16384,
    FeedbackSuccess = 32768,
    FeedbackWarning = 65536,
    FeedbackError = 131072,
    FeedbackInfo = 262144,
}

/// A replacement for some colors of the current theme.
///
/// Pass it to `Theme::push`. Colors that are not flagged in `ThemeOverride.slots` keep the value they have in the
/// theme at the time of the push.
struct ThemeOverride {
    /// The colors to replace, as `ThemeSlot` flags combined with a bitwise OR.
    slots: u32,
    /// The new colors. Only the ones flagged in `ThemeOverride.slots` are used.
    colors: ThemeColors,
}

/// The colors used to paint widgets.
///
/// Call `Theme::update` to set the base palette. Between `Theme::push` and the matching `Theme::pop`, widgets use
/// the pushed override instead.
#[frame_context]
api Theme {
    /// Sets the base palette that flowi paints with.
    ///
    /// flowi keeps the pointer and reads it every frame, so `colors` must stay valid and unchanged until the next
    /// call. The Rust wrapper copies the palette, so a reference to a temporary is fine there.
    ///
    /// If `colors` is null, flowi uses the built-in default palette.
    [manual] update(colors: *const ThemeColors)
    /// Replaces some colors of the current theme until the matching `Theme::pop`.
    ///
    /// Overrides nest, up to 16 at a time. An inner push builds on the theme the outer push produced.
    push(theme_override: ThemeOverride)
    /// Ends the most recent `Theme::push` and restores the theme from before it.
    ///
    /// Call it once for every push.
    pop()
    /// Returns the palette widgets are painted with now.
    ///
    /// This is the pushed override if one is active, otherwise the base palette. Before any call to `Theme::update`
    /// it is the built-in default palette.
    ///
    /// Do not keep the pointer past the matching `Theme::pop` or the next `Theme::update`.
    [manual] colors() -> *const ThemeColors
}
