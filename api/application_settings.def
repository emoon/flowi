/// The render backend an app draws with.
///
/// On Apple platforms a windowed app that asks for `AppRenderer::Software` gets `AppRenderer::Metal` instead.
enum AppRenderer {
    /// The software renderer. This is the default.
    Software = 0,
    /// The GPU backend. `App::create` fails and logs the reason on a build without GPU support.
    Gpu = 1,
    /// The Metal GPU backend.
    Metal = 2,
}

/// The settings for `App::create`.
struct AppSettings {
    /// The title of the main window.
    window_title: String,
    /// The width of the main window, in logical pixels (above 0). The window is created at this width times the
    /// display content scale.
    width: i32,
    /// The height of the main window, in logical pixels (above 0). The window is created at this height times the
    /// display content scale.
    height: i32,
    /// Whether the app runs offscreen, with no window. Input then comes from the `App` inject calls.
    headless: bool,
    /// The render backend (`AppRenderer::Software` is the default).
    renderer: AppRenderer,
    /// Whether the main window opens fullscreen. `width` and `height` are the size it returns to. Ignored when
    /// `headless` is true.
    fullscreen: bool,
    /// Whether the user is blocked from resizing the window.
    fixed_size: bool,
}
