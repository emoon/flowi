#[module(platform)]

/// A mouse button.
///
/// `MouseButton::Count` is the number of buttons, not a button.
enum MouseButton {
    Left = 0,
    Right,
    Middle,
    X1,
    X2,
    Count,
}

/// A gamepad button.
///
/// `GamepadButton::Count` is the number of buttons, not a button.
enum GamepadButton {
    A = 0,
    B,
    X,
    Y,
    Left_Bumper,
    Right_Bumper,
    Back,
    Start,
    Guide,
    Left_Thumb,
    Right_Thumb,
    Dpad_Up,
    Dpad_Right,
    Dpad_Down,
    Dpad_Left,
    Count,
}

/// A gamepad analog axis.
///
/// `GamepadAxis::Count` is the number of axes, not an axis.
enum GamepadAxis {
    Left_X = 0,
    Left_Y,
    Right_X,
    Right_Y,
    Left_Trigger,
    Right_Trigger,
    Count,
}

/// What a `KeyEvent` reports.
#[enumerators(KeyEvent)]
enum KeyEventType {
    Down = 0,
    Up,
    Repeat,
}

/// What a `MouseEvent` reports.
///
/// It also tells which payload of the event is set.
#[enumerators(MouseEvent)]
enum MouseEventType {
    Move = 0,
    Button_Down,
    Button_Up,
    Wheel,
    Enter,
    Leave,
    /// Raw motion during a hidden drag. It has a delta and no position.
    Relative_Motion,
}

/// What a `GamepadEvent` reports.
///
/// It also tells which payload of the event is set.
#[enumerators(GamepadEvent)]
enum GamepadEventType {
    Button_Down = 0,
    Button_Up,
    Axis_Motion,
    Connected,
    Disconnected,
}

/// What a `WindowEvent` reports.
///
/// It also tells which payload of the event is set.
#[enumerators(WindowEvent)]
enum WindowEventType {
    None = 0,
    Focus_Gained,
    Focus_Lost,
    Resize,
    Close,
    /// A file was dropped onto the window. A drop of several files gives one event per file.
    Drop_File,
}

/// The payload of a `MouseEvent` of type `MouseEventType::Move`.
///
/// It holds the cursor position and the change since the previous move, in window pixels.
#[attributes(Copy)]
struct MouseMoveData {
    x: f32,
    y: f32,
    delta_x: f32,
    delta_y: f32,
}

/// The payload of a `MouseEvent` of type `MouseEventType::Button_Down` or `MouseEventType::Button_Up`.
///
/// It holds the button, the cursor position in window pixels and the click count, which you can use to detect a
/// double-click.
#[attributes(Copy)]
struct MouseButtonData {
    button: MouseButton,
    x: f32,
    y: f32,
    click_count: u32,
}

/// The payload of a `MouseEvent` of type `MouseEventType::Wheel`.
///
/// It holds the wheel delta of the event. A positive y means scrolled up.
#[attributes(Copy)]
struct MouseWheelData {
    x: f32,
    y: f32,
}

/// The payload of a `MouseEvent` of type `MouseEventType::Relative_Motion`.
///
/// It holds the raw motion of a hidden drag.
#[attributes(Copy)]
struct MouseRelativeData {
    delta_x: f32,
    delta_y: f32,
}

/// The payload of a `GamepadEvent` of type `GamepadEventType::Button_Down` or `GamepadEventType::Button_Up`.
#[attributes(Copy)]
struct GamepadButtonData {
    button: GamepadButton,
}

/// The payload of a `GamepadEvent` of type `GamepadEventType::Axis_Motion`.
///
/// It holds the axis and its new value.
#[attributes(Copy)]
struct GamepadAxisData {
    axis: GamepadAxis,
    value: f32,
}

/// The payload of a `WindowEvent` of type `WindowEventType::Resize`.
///
/// It holds the new window size in pixels.
#[attributes(Copy)]
struct WindowResizeData {
    width: u32,
    height: u32,
}

/// The payload of a `WindowEvent` of type `WindowEventType::Drop_File`.
///
/// It holds the path of the dropped file and the cursor position in window pixels where it was released.
#[attributes(Copy)]
struct WindowDropData {
    path: String,
    x: f32,
    y: f32,
}

/// A keyboard event for `Input::push_key_event`.
#[attributes(Copy)]
struct KeyEvent {
    type: KeyEventType,
    key: Key,
    modifiers: KeyModifier,
    repeat: bool,
    timestamp: u64,
}

/// A text input event for `Input::push_text_input_event`, holding the composed characters.
#[attributes(Copy)]
struct TextInputEvent {
    text: String,
    timestamp: u64,
}

/// A mouse event for `Input::push_mouse_event`.
///
/// `type` says which payload is set: `move` for `MouseEventType::Move`, `button` for `MouseEventType::Button_Down`
/// and `MouseEventType::Button_Up`, `wheel` for `MouseEventType::Wheel` and `relative` for
/// `MouseEventType::Relative_Motion`. `MouseEventType::Enter` and `MouseEventType::Leave` have no payload.
#[attributes(Copy)]
struct MouseEvent {
    type: MouseEventType,
    union {
        move: MouseMoveData,
        button: MouseButtonData,
        wheel: MouseWheelData,
        relative: MouseRelativeData
    },
    timestamp: u64,
}

/// A gamepad event for `Input::push_gamepad_event`.
///
/// `gamepad_id` is the device. `type` says which payload is set: `button` for the two button types and `axis` for
/// `GamepadEventType::Axis_Motion`. `GamepadEventType::Connected` and `GamepadEventType::Disconnected` have no
/// payload.
#[attributes(Copy)]
struct GamepadEvent {
    type: GamepadEventType,
    gamepad_id: u32,
    union {
        button: GamepadButtonData,
        axis: GamepadAxisData
    },
    timestamp: u64,
}

/// A window event for `Input::push_window_event`.
///
/// `type` says which payload is set: `resize` for `WindowEventType::Resize` and `drop` for
/// `WindowEventType::Drop_File`. The other types have no payload.
#[attributes(Copy)]
struct WindowEvent {
    type: WindowEventType,
    union {
        resize: WindowResizeData,
        drop: WindowDropData
    },
    timestamp: u64,
}
