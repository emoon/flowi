/// The font, size and letter spacing used to measure or draw one line of text.
///
/// This is passed to `Text::measure` and `Painter::text_styled`. A zero field uses the fallback named on the field.
#[attributes(Copy)]
struct TextStyle {
    /// The font to use (0 uses the active font).
    font_id: u32,
    /// The size in pixels, fractions allowed (0 uses the font's default size).
    font_size: f32,
    /// The extra space between glyphs, in pixels. A string of n glyphs gets n - 1 gaps.
    letter_spacing: f32,
}

/// The size of one line of text, in logical pixels.
///
/// This is returned by `Text::measure`.
#[attributes(Copy)]
struct TextMetrics {
    /// The width of the text, including letter spacing.
    width: f32,
    /// The height of a line at this size.
    height: f32,
    /// The distance from the baseline up to the top.
    ascent: f32,
    /// The distance from the baseline down to the bottom (positive).
    descent: f32,
}

/// Text that takes part in the layout.
///
/// Call `Text::emit` for plain text, or `Text::styled` to choose the font, size, color and wrapping. Use
/// `Text::measure` to get the size of a line without drawing it.
#[frame_context]
api Text {
    /// Adds text in the theme's primary color as a child of the current container.
    emit(text: String)
    /// Adds text styled by `config` as a child of the current container.
    styled(text: String, config: TextConfig)
    /// Measures a single line of text without drawing it.
    ///
    /// The result matches what `Painter::text_styled` draws with the same `style`. A font that is not loaded
    /// measures as all zeroes.
    [borrowed] measure(text: String, style: TextStyle) -> TextMetrics
}
