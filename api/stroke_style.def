/// The dash pattern of a stroked outline: one dash and one gap, repeated along the stroke.
///
/// This is the `Stroke.dash` field. A zero `dash_len` or `gap_len` gives a solid stroke, so a zeroed style is the
/// default. The pattern does not start at a fixed point. The period is adjusted slightly so that a whole number
/// of dashes closes the ring or edge, with no stub at the seam.
#[attributes(Copy)]
struct StrokeStyle {
    /// The length of each dash, in logical pixels (0 gives a solid stroke).
    dash_len: f32,
    /// The length of the gap between dashes, in logical pixels (0 gives a solid stroke).
    gap_len: f32,
}
