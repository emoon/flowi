/// When a scroll area or list shows its scrollbar.
///
/// This is the type of `ScrollAreaConfig.scrollbar_mode`. A scrollbar is only drawn when the content is larger
/// than the view.
enum ScrollbarDisplayMode {
    /// Never shown.
    Never = 0,
    /// Shown while the mouse is over the area or the thumb is being dragged.
    Auto = 1,
    /// Always shown.
    Always = 2,
}
