#[module(vfs)]

extern opaque FlVfsPluginInfo
extern opaque FlArena

/// The status codes a driver returns.
///
/// Drivers use the most specific code they can. The codes are grouped in hundreds: file, IO, permission, resource,
/// archive, network, HTTP and generic.
enum VfsStatus {
    Success = 0,

    /// File or path not found.
    FileNotFound = 100,
    /// Path is malformed.
    PathInvalid = 101,
    /// Path exceeds the platform limit.
    PathTooLong = 102,
    /// Expected a directory, found a file.
    NotADirectory = 103,
    /// Expected a file, found a directory.
    IsADirectory = 104,

    ReadError = 200,
    WriteError = 201,
    SeekError = 202,
    /// End of file.
    Eof = 203,
    /// Destination buffer too small.
    BufferTooSmall = 204,

    AccessDenied = 300,
    PermissionDenied = 301,

    OutOfMemory = 400,
    TooManyOpenFiles = 401,
    ResourceBusy = 402,
    DiskFull = 403,

    /// Generic archive error.
    ArchiveError = 500,
    ArchiveCorrupt = 501,
    /// Archive format unsupported.
    ArchiveUnsupported = 502,
    /// Archive requires a password.
    ArchivePasswordRequired = 503,

    /// Generic network error.
    NetworkError = 600,
    NetworkTimeout = 601,
    NetworkUnavailable = 602,
    /// DNS resolution failed.
    NetworkDns = 603,
    NetworkConnectionRefused = 604,
    /// SSL/TLS error.
    NetworkSsl = 605,

    /// HTTP 400, bad request (base of the 700-799 HTTP range).
    NetworkBadRequest = 700,
    /// HTTP 401, unauthorized.
    NetworkUnauthorized = 701,
    /// HTTP 403, forbidden.
    NetworkForbidden = 703,
    /// HTTP 404, not found.
    NetworkNotFound = 704,
    /// HTTP 5xx, server error.
    NetworkServerError = 750,

    GenericError = 900,
    /// Operation not implemented by this driver.
    NotImplemented = 901,
    /// Invalid handle passed to the driver.
    InvalidHandle = 902,
    /// Operation was canceled.
    OperationCanceled = 903,
}

/// The features a driver supports, combined with OR.
///
/// A driver returns them from its `get_capabilities` function. The VFS uses them to decide which operations a
/// driver can handle.
#[attributes(bitflags)]
enum VfsDriverCapabilities {
    /// Can read files.
    Read = 1,
    /// Can list directories.
    List = 4,
    /// Can open from memory (nested archives).
    Memory = 16,
    /// Can provide OS file paths (optimization).
    DirectPath = 32,
    /// Supports caching.
    Cache = 64,
    /// Is an archive format.
    Archive = 256,
    /// Is a network filesystem.
    Network = 512,
}

/// The flags passed to a driver's `open` function, combined with OR.
#[attributes(bitflags)]
enum VfsOpenFlags {
    /// Open for reading.
    Read = 1,
}

/// The error a driver returns with a result.
///
/// Check `VfsDriverError.vfs_status` first. `VfsDriverError.native_error` adds the underlying code.
struct VfsDriverError {
    /// The VFS error code (always set).
    vfs_status: VfsStatus,
    /// The native error code, such as an errno or an HTTP status (0 if none).
    native_error: i32,
    /// Extra data specific to the driver (optional).
    additional_data: u64,
}

/// The outcome of a plugin's `create` function.
///
/// Use `PluginCreateResult.instance` only if `PluginCreateResult.error` has the status `VfsStatus::Success`.
struct PluginCreateResult {
    /// The plugin instance, or null on error.
    instance: *void,
    /// The error, or `VfsStatus::Success`.
    error: VfsDriverError,
}

/// The outcome of a driver's `open` function.
struct VfsOpenResult {
    /// The driver's handle, or null on error.
    handle: *void,
    /// Whether the handle is a directory or an archive, which can be listed.
    is_directory: bool,
    /// The error, or `VfsStatus::Success`.
    error: VfsDriverError,
}

/// The outcome of a driver's `read` function.
struct VfsReadResult {
    /// The number of bytes read, or -1 on error.
    bytes_read: i64,
    /// The error, or `VfsStatus::Success`.
    error: VfsDriverError,
}

/// The outcome of a driver's `get_size` function.
struct VfsSizeResult {
    /// The size in bytes, or -1 on error.
    size: i64,
    /// The error, or `VfsStatus::Success`.
    error: VfsDriverError,
}

/// A file or directory in a listing.
struct VfsEntry {
    /// The name of the entry, not a full path.
    name: String,
    /// The size in bytes (0 for a directory).
    size: i64,
    /// The attributes of the entry, which depend on the platform.
    attributes: u32,
    /// Whether the entry is a directory.
    is_directory: bool,
    /// Whether the entry can be opened as an archive, such as a zip file.
    is_archive: bool,
}

/// The options of a mount, which apply to every file read through it.
///
/// Pass them to `Vfs::fl_vfs_mount_with_options`. The VFS hands them to the driver's `open` function.
struct VfsMountOptions {
    /// The directory where caching plugins write their cache (empty uses the default cache).
    ///
    /// The file name comes from the URL. The directory must exist.
    cache_dir: String,
    /// Whether to check cached files against the server (ETag) before use. This is for remote files that can
    /// change. When false, the cache is used without a check.
    cache_validation: bool,
}

/// A driver that gives the VFS access to local files, archives, network filesystems or virtual filesystems.
///
/// Report what the driver supports from `get_capabilities`. `open_memory`, `get_file_path` and `is_cached` are
/// null if the driver does not support them.
struct VfsPlugin {
    /// The plugin API version the driver was built for.
    api_version: u64,
    /// The name of the plugin.
    plugin_name: String,
    /// Metadata about the plugin, such as version and author (null if none).
    plugin_info: *FlVfsPluginInfo,

    /// Creates a driver instance.
    create() -> PluginCreateResult,
    /// Destroys an instance made by `create`.
    destroy(driver_instance: *void),

    /// Returns true if the path looks like one this driver handles, without doing any I/O.
    ///
    /// The VFS uses it to pick a driver.
    supports_path(path: String) -> bool,
    /// Returns true if the driver can open the path. This may do I/O.
    can_open(path: String) -> bool,

    /// Opens a file or directory and returns the result.
    ///
    /// The path is relative to `parent_handle`, or absolute if `parent_handle` is null. The VFS supplies
    /// `mount_options`.
    open(driver_instance: *void, parent_handle: *void, path: String, flags: u32, mount_options: VfsMountOptions) -> VfsOpenResult,
    /// Returns true if an open handle is a directory or an archive.
    is_directory(driver_instance: *void, handle: *void) -> bool,

    /// Reads file contents into `buffer`, which the caller owns.
    ///
    /// A non-empty `relative_path` names a file below `handle`, and it is read from its start. An empty one reads
    /// the file `handle` was opened on, from its current offset.
    read(driver_instance: *void, handle: *void, relative_path: String, buffer: *u8, size: i64) -> VfsReadResult,
    /// Returns the size of a file.
    ///
    /// `relative_path` is resolved against `handle` as for `read`. The size is -1 for a directory or a
    /// path that does not exist.
    get_size(driver_instance: *void, handle: *void, relative_path: String) -> VfsSizeResult,

    /// Lists a directory by calling `callback` for each entry.
    ///
    /// The listing stops when the callback returns false.
    list_directory(driver_instance: *void, handle: *void, relative_path: String, callback: VfsListingCallback, user_data: *void),
    /// Closes a handle and frees its resources.
    close(driver_instance: *void, handle: *void),

    /// Returns the features the driver supports.
    get_capabilities() -> VfsDriverCapabilities,

    /// Opens an archive from a memory buffer. This needs `VfsDriverCapabilities::Memory` (null if unsupported).
    ///
    /// On success the driver owns `data`. On failure the caller keeps it.
    open_memory(driver_instance: *void, data: *const u8, size: u64, original_path: String) -> VfsOpenResult,
    /// Returns an operating system path for a resource, allocated from `arena`. This needs
    /// `VfsDriverCapabilities::DirectPath` (null if unsupported).
    ///
    /// The string is empty if no path is available.
    get_file_path(driver_instance: *void, handle: *void, relative_path: String, arena: *FlArena) -> String,
    /// Returns true if a path is cached and fresh. This needs `VfsDriverCapabilities::Cache` (null if unsupported).
    is_cached(driver_instance: *void, path: String) -> bool,
}
