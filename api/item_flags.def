/// The behaviors an element can have, as a bitmask.
///
/// Pass it to `Item::behavior` to turn a laid-out element into an interactive one. Combine values with bitwise OR.
#[attributes(bitflags)]
enum ItemFlags {
    /// The element can be clicked.
    clickable = 1,
    /// The element can be dragged.
    draggable = 2,
    /// The element can take keyboard and gamepad focus.
    focusable = 4,
    /// The element reports double clicks in `Signal.double_clicked`. It needs `ItemFlags::clickable` as well.
    double_click = 8,
    /// The element reports right clicks in `Signal.right_clicked`. It needs `ItemFlags::clickable` or
    /// `ItemFlags::draggable` as well.
    right_click = 16,
    /// The element animates `ElementState.hot_t` while it is hovered.
    hot_animation = 32,
    /// The element animates `ElementState.active_t` while it is pressed.
    active_animation = 64,
    /// The element animates `ElementState.focused_t` while it has focus.
    focus_animation = 128,
    /// The element reports the mouse wheel in `Signal.wheel_delta` while it is hovered. It needs `ItemFlags::clickable`
    /// or `ItemFlags::draggable` as well, which is what makes it hovered.
    scroll_target = 256,
    /// The element takes focus once, when it first appears. It needs `ItemFlags::focusable` as well.
    auto_focus = 512,
}
