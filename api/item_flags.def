/// Per-element behavior opt-in flags - the bitmask ui_item_behavior(id, flags, cfg) takes to turn a laid-out
/// area into an interactive widget (clickable, draggable, focusable, ...). Combine flags with bitwise OR
/// (ItemFlags::CLICKABLE | ItemFlags::DRAGGABLE).
#[attributes(bitflags)]
enum ItemFlags {
    /// Responds to clicks.
    clickable = 1,
    /// Can be dragged (sliders, scrollbars, windows).
    draggable = 2,
    /// Can receive keyboard/gamepad focus.
    focusable = 4,
    /// Track double-click events.
    double_click = 8,
    /// Track right-click events.
    right_click = 16,
    /// Animate hot_t on hover.
    hot_animation = 32,
    /// Animate active_t when pressed.
    active_animation = 64,
    /// Animate focused_t when focused.
    focus_animation = 128,
    /// Responds to the mouse wheel (scroll target).
    scroll_target = 256,
    /// Request focus automatically when the element first appears (requires focusable).
    auto_focus = 512,
}
