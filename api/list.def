/// A row of an `Input::list`.
#[attributes(Copy)]
struct ListItem {
    /// The id of the row (unique, never 0).
    id: u64,
    /// The text shown on the row, also matched by type-ahead.
    label: String,
    /// The icon drawn before the label, or an invalid handle for none.
    icon: ImageHandle,
}

/// A column of a list or tree with a header.
///
/// Pass the columns in `ListConfig.columns`, in the order they are drawn. You own the widths: when the user resizes
/// a column, `ListResult.resized_column` reports it, and you pass the new width back as `width` on the next frame.
#[attributes(Copy)]
struct ColumnDef {
    /// The id of the column (unique, never 0). Signals and results name a column by this id.
    id: u32,
    /// The text shown in the header.
    title: String,
    /// The width of the column, in logical pixels (0 makes the column flexible).
    width: f32,
    /// The share of the leftover width a flexible column takes (0 uses 1).
    flex: f32,
    /// The narrowest the column can get, in logical pixels (0 for no minimum).
    ///
    /// If the columns do not fit, a flexible column stays at its minimum, a fixed one keeps its `width`, and the
    /// right edge is clipped.
    min_width: f32,
}

/// Options for `List::begin`.
///
/// A field left at zero uses its default.
#[attributes(Copy)]
struct ListConfig {
    /// The height of every row, in logical pixels (0 uses 32).
    row_height: f32,
    /// The space between rows, in logical pixels (0 uses 8).
    gap: f32,
    /// The labels matched by type-ahead, one per id in the same order (null turns type-ahead off).
    labels: *const String,
    /// Whether you draw the row drag yourself, from the drag fields of `ListResult`.
    suppress_drag_visuals: bool,
    /// When the scrollbar is shown (`ScrollbarDisplayMode::Never` by default). The mouse wheel always scrolls.
    scrollbar_mode: ScrollbarDisplayMode,
    /// The columns (`column_count` entries, null for a list without columns).
    ///
    /// With columns, the list draws a header above the rows that stays in place while they scroll. Draw each cell
    /// of a row with `Cell::begin`.
    ///
    /// If typing in the table starts an edit, leave `labels` null so type-ahead does not take the keys.
    columns: *const ColumnDef,
    /// The number of entries in `columns`.
    column_count: u32,
    /// The height of the header, in logical pixels (0 uses `row_height`).
    header_height: f32,
}

/// Options for `Input::list`.
///
/// A field left at zero uses its default.
#[attributes(Copy)]
struct ListOpts {
    /// The height of every row, in logical pixels (0 uses 32).
    row_height: f32,
    /// The space between rows, in logical pixels (0 uses 8).
    gap: f32,
    /// Whether the user can select several rows. When false, a click selects one row and unselects the rest.
    multi_select: bool,
    /// Whether the user can drag rows to a new position. See `ListResult.reorder_emitted`.
    reorderable: bool,
    /// Whether you draw the row drag yourself, from the drag fields of `ListResult`.
    suppress_drag_visuals: bool,
    /// When the scrollbar is shown (`ScrollbarDisplayMode::Never` by default). The mouse wheel always scrolls.
    scrollbar_mode: ScrollbarDisplayMode,
}

/// The side of `ListResult.drag_target_id` that dragged rows land on.
enum DropRelationship {
    /// Before the target row.
    Before = 0,
    /// After the target row.
    After,
    /// As children of the target row. A List never reports this.
    Into,
}

/// The rows to draw this frame.
///
/// This is returned by `List::begin`. Draw the rows from `start` up to, and not including, `end`.
#[attributes(Copy)]
struct ListRange {
    /// The index of the first row to draw (inclusive).
    start: u32,
    /// The index after the last row to draw (exclusive).
    end: u32,
    /// The number of rows passed to `List::begin`.
    total: u32,
}

/// The outcome of a list for one frame.
///
/// This is returned by `List::end` and `Input::list`. The ids are the ones you passed in, and 0 means no row.
#[attributes(Copy)]
struct ListResult {
    /// The row the user activated with a double-click, Enter or Space.
    activated_id: u64,
    /// The row under the mouse, or under the keyboard cursor while the list has focus.
    focused_id: u64,
    /// The row the user right-clicked. The list opens no menu, so open yours for this row.
    context_menu_id: u64,
    /// The column the user right-clicked in the row `context_menu_id` (0 for none).
    context_menu_cell: u32,
    /// The selection changes of this frame (`request_count` entries, valid this frame only).
    ///
    /// These are already applied if you passed a set. Otherwise apply them yourself.
    requests: *const SelectionRequest,
    /// The number of entries in `requests`.
    request_count: u32,
    /// Whether the user pressed Up on the first row. Use it to move focus above the list.
    nav_up_edge: bool,
    /// Whether the user pressed Down on the last row. Use it to move focus below the list.
    nav_down_edge: bool,
    /// Whether rows are being dragged. The drag fields then say where they would land.
    drag_active: bool,
    /// Whether the dragged rows were dropped this frame.
    ///
    /// If so, move `drag_from_ids` to the `drag_rel` side of `drag_target_id` in your own data. The target can
    /// be one of the dragged rows.
    reorder_emitted: bool,
    /// The dragged rows (`drag_from_count` entries in no particular order, valid this frame only).
    ///
    /// This is every row in your set if the drag started on a selected row, and only the pressed row otherwise.
    drag_from_ids: *const u64,
    /// The row the drop is next to.
    drag_target_id: u64,
    /// The number of entries in `drag_from_ids`.
    drag_from_count: u32,
    /// The side of `drag_target_id` the rows land on.
    drag_rel: DropRelationship,
    /// The column whose header the user clicked (0 for none). The list does not sort.
    header_clicked_column: u32,
    /// The column the user is resizing (0 for none).
    ///
    /// It is reported on each frame of the drag, once the mouse has moved.
    resized_column: u32,
    /// The width of `resized_column`, in logical pixels.
    resized_width: f32,
    /// The width every column got this frame, in logical pixels (`column_width_count` entries, valid this frame
    /// only).
    ///
    /// Read it to save the layout. The entries follow the order of `ListConfig.columns`. It is empty on the first
    /// frames of a list, until the list knows how wide it is.
    column_widths: *const f32,
    /// The number of entries in `column_widths`.
    column_width_count: u32,
}
