/// What the user did to a widget this frame.
///
/// Every interactive widget returns it, and so does `Item::behavior`. `clicked` is the one most callers read. A field
/// that needs a behavior the widget did not ask for, such as `double_clicked`, stays false.
#[attributes(Copy)]
struct Signal {
    /// Whether the widget was clicked, or activated with the keyboard or gamepad.
    clicked: bool,
    /// Whether the cursor is over the widget. It is only set for a widget that is clickable or draggable.
    hovered: bool,
    /// Whether the widget has keyboard or gamepad focus.
    focused: bool,
    /// Whether the user activated the widget with Enter, Space or the gamepad A button.
    activated: bool,
    /// Whether the user double-clicked the widget. It needs `ItemFlags::double_click` and `ItemFlags::clickable`.
    double_clicked: bool,
    /// Whether the user pressed the right mouse button on the widget. It needs `ItemFlags::right_click` and a
    /// widget that is hovered, so `ItemFlags::clickable` or `ItemFlags::draggable`.
    right_clicked: bool,
    /// Whether the mouse button went down on the widget this frame. It needs `ItemFlags::clickable`.
    pressed: bool,
    /// Whether the mouse button was released this frame after being pressed on the widget. It needs
    /// `ItemFlags::clickable`.
    released: bool,
    /// Whether the widget is being dragged. It needs `ItemFlags::draggable`.
    dragging: bool,
    /// Whether the row is in the selection of its list. Only `List::item_begin` sets it.
    selected: bool,
    /// The mouse position relative to the widget, in physical pixels.
    mouse_pos: Vec2,
    /// How far the mouse has moved since the drag started.
    drag_delta: Vec2,
    /// The mouse wheel movement over the widget. It needs `ItemFlags::scroll_target`, and `ItemFlags::clickable` or
    /// `ItemFlags::draggable` to make the widget hovered.
    wheel_delta: Vec2,
    /// Whether a text input was edited this frame. Only text inputs set it.
    text_changed: bool,
    /// Whether Enter was pressed in a text input this frame. Only text inputs set it.
    submitted: bool,
    /// Whether Escape or the gamepad Cancel button (B) was pressed in a text input this frame.
    ///
    /// Only text inputs set it.
    cancelled: bool,
}
