#[module(core)]

/// How severe a log message is, from least to most severe.
enum LogLevel {
    /// Fine-grained tracing.
    Trace = 0,
    /// Debugging detail.
    Debug = 1,
    /// Progress information.
    Info = 2,
    /// A recoverable problem or something unexpected.
    Warning = 3,
    /// An operation failed.
    Error = 4,
    /// An unrecoverable failure.
    Fatal = 5,
}

/// Logging to named channels, with a minimum level for each.
///
/// Register a channel with `Log::register_channel` and pass its id to `Log::c_message_formatted` or
/// `Log::c_message`. Messages go to stderr and to the log file if `Log::file_init` has opened one. `Log::message`
/// logs on a channel named CORE instead.
api Log {
    /// Registers a channel called `name` and returns its id.
    ///
    /// Registering a name that already exists returns the id of that channel. There is room for 32 channels,
    /// including the CORE channel `Log::message` uses. When they are all taken it returns `u32::MAX`, even for a
    /// name that exists. That is not a registered channel, so messages logged to it appear under a channel named
    /// DEFAULT. `name` must stay valid for the rest of the program.
    [manual] register_channel(name: String) -> u32
    /// Sets the lowest level that channel `id` logs.
    ///
    /// A new channel starts at the level set by `Log::set_level`, or `LogLevel::Trace` if it was never called.
    [manual] channel_set_level(id: u32, level: LogLevel)
    /// Turns channel `id` on or off.
    ///
    /// Messages to a disabled channel are dropped.
    [manual] channel_enable(id: u32, enabled: bool)
    /// Logs `message` on channel `id` as it is, without printf formatting.
    ///
    /// `file` and `line` name the source location shown with the message. `file` may be null.
    [manual] c_message_formatted(id: u32, level: LogLevel, file: *const char, line: i32, message: String)
    /// Sets whether messages show their source file and line.
    [manual] set_show_location(show: bool)
    /// Opens the log file under `base_dir` and returns whether it succeeded.
    ///
    /// An empty `base_dir` uses the application's data directory in the home directory. A log file from an earlier
    /// run is renamed with the suffix `.old`, replacing the previous `.old` file.
    [manual] file_init(base_dir: String) -> bool
    /// Closes the log file.
    [manual] file_shutdown()
    /// Returns the path of the log file, or an empty string if `Log::file_init` has not opened one.
    ///
    /// The path stays readable after `Log::file_shutdown`.
    [manual] file_get_path() -> String
    /// Flushes log output.
    ///
    /// Messages are written as they are logged, so this currently does nothing.
    [manual] flush()
    /// Sets the lowest level that every channel logs, including channels registered later.
    ///
    /// This replaces the level of each channel set with `Log::channel_set_level`.
    [manual] set_level(level: LogLevel)
    /// Logs a printf-style message on channel `id`.
    ///
    /// `file` and `line` name the source location shown with the message. `file` may be null.
    [manual] c_message(id: u32, level: LogLevel, file: *const char, line: i32, format: *const char, ...)
    /// Logs a printf-style message on a channel named CORE.
    ///
    /// `file` and `line` name the source location shown with the message. `file` may be null.
    [manual] message(level: LogLevel, file: *const char, line: i32, format: *const char, ...)
}
