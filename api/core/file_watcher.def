#[module(core)]

extern opaque FlArena

/// A kind of file system change.
///
/// `FileChange.change_types` combines them as a bitmask.
#[attributes(bitflags)]
enum FileChangeType {
    None = 0,
    /// The file or directory was created.
    Created = 1,
    /// The file or directory was modified.
    Modified = 2,
    /// The file or directory was deleted.
    Deleted = 4,
    /// The file or directory was renamed.
    Renamed = 8,
    /// The file or directory was moved.
    Moved = 16,
}

/// What a watcher reports, passed to `FileWatcher::start`.
struct FileWatcherConfig {
    /// Whether to watch subdirectories too.
    recursive: bool,
    /// Whether to report changes to files.
    watch_files: bool,
    /// Whether to report changes to directories.
    watch_directories: bool,
    /// The most changes to keep between calls to `FileWatcher::take_changes` (0 uses 1000).
    max_changes: u32,
}

/// One file system change.
///
/// The paths belong to the arena passed to `FileWatcher::take_changes` and stay valid until you reset it.
struct FileChange {
    /// The full path of the changed file or directory.
    path: String,
    /// The previous path after a rename or move, and empty otherwise.
    old_path: String,
    /// The kinds of change, as a bitmask of `FileChangeType` values.
    change_types: FileChangeType,
    /// When the change happened, in microseconds since the epoch.
    timestamp: u64,
    /// Whether the change is to a directory rather than a file.
    is_directory: bool,
}

/// The changes `FileWatcher::take_changes` took from a watcher.
///
/// The array is allocated in the arena you passed to `FileWatcher::take_changes` and stays valid until you reset it.
struct FileChanges {
    /// The changes, or null if there are none.
    changes: *const FileChange,
    /// The number of entries in `FileChanges.changes`.
    count: u32,
    /// Whether the watcher dropped changes because more than `FileWatcherConfig.max_changes` arrived between calls.
    has_overflow: bool,
}

/// A watcher that reports file system changes under a path.
///
/// Call `FileWatcher::start` on a file or directory and poll `FileWatcher::has_changes` each frame. When it returns
/// true, call `FileWatcher::take_changes` to get the pending changes. Taking them clears them, so each change is
/// reported once. Call `FileWatcher::stop` when you are done.
api FileWatcher {
    /// Starts watching `path` and returns a watcher handle.
    ///
    /// Returns 0 if `config` is null, `path` does not exist, the platform cannot watch it or too many watchers
    /// are running.
    [manual] start(path: String, config: *const FileWatcherConfig) -> u32
    /// Stops the watcher and releases its resources.
    ///
    /// Passing 0 does nothing.
    [manual] stop(handle: u32)
    /// Returns whether the watcher is still running.
    [manual] is_active(handle: u32) -> bool
    /// Returns whether changes are waiting to be taken.
    [manual] has_changes(handle: u32) -> bool
    /// Takes the pending changes into `arena` and clears them from the watcher.
    ///
    /// Several changes to one path in quick succession are reported as one entry. A moved file is also reported as
    /// modified. If the handle is not valid, the returned `FileChanges` is empty.
    [manual] take_changes(handle: u32, arena: *FlArena) -> FileChanges
}
