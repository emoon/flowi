#[module(core)]

/// A snapshot of memory use: the live arenas and the mimalloc allocation balance.
///
/// `MemoryTracker::get_stats` fills it in. The mimalloc fields are 0 in a build that does not use mimalloc.
#[attributes(Copy)]
struct MemoryStats {
    /// The number of live arenas across all threads.
    live_arena_count: u32,
    /// The reserved capacity of all arenas, in bytes.
    total_arena_capacity: u64,
    /// The memory in use across all arenas, in bytes.
    total_arena_used: u64,
    /// The peak memory use across all arenas, in bytes.
    total_arena_peak: u64,
    /// The mimalloc memory in use (allocated minus freed), in bytes.
    mimalloc_current: u64,
    /// The bytes allocated through mimalloc.
    mimalloc_total_allocated: u64,
    /// The bytes freed through mimalloc.
    mimalloc_total_freed: u64,
    /// The number of mimalloc allocations. Block counts cover the calling thread's heap and exited threads.
    mimalloc_alloc_count: u64,
    /// The number of mimalloc frees. A block freed while the thread that allocated it is still running counts as live
    /// until that thread next allocates or collects.
    mimalloc_free_count: u64,
}

/// Memory use reports for finding leaks.
///
/// Call `MemoryTracker::init` early in startup and `MemoryTracker::destroy` at shutdown. In between, read the numbers
/// with `MemoryTracker::get_stats`, or get a report of every live arena from `MemoryTracker::dump_string` or
/// `MemoryTracker::export_json_string`.
api MemoryTracker {
    /// Starts tracking arenas.
    ///
    /// Call it early in application startup.
    [manual] init()
    /// Stops tracking arenas.
    ///
    /// Call it at application shutdown.
    [manual] destroy()
    /// Returns a text report of memory use, allocated from `arena`.
    ///
    /// Returns an empty string if `arena` is null.
    [manual] dump_string(arena: *Arena) -> String
    /// Writes the text report from `MemoryTracker::dump_string` to `filepath`, replacing the file.
    ///
    /// Returns whether it succeeded. An empty `filepath` fails.
    [manual] dump_to_file(filepath: String) -> bool
    /// Returns a JSON report of memory use, allocated from `arena`.
    ///
    /// Returns an empty string if `arena` is null.
    [manual] export_json_string(arena: *Arena) -> String
    /// Writes the JSON report from `MemoryTracker::export_json_string` to `filepath`, replacing the file.
    ///
    /// Returns whether it succeeded. An empty `filepath` fails.
    [manual] export_json_to_file(filepath: String) -> bool
    /// Fills `stats` with the current memory use.
    ///
    /// It also reclaims empty pages in the calling thread's heap.
    [manual] get_stats(stats: *MemoryStats)
}
