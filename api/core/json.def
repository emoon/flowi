#[module(core)]

/// The kind of a `JsonValue`, stored in `JsonValue.type`.
enum JsonType {
    String = 0,
    Number = 1,
    Object = 2,
    Array = 3,
    True = 4,
    False = 5,
    Null = 6,
}

/// Why a parse failed, stored in `JsonParseResult.error`.
///
/// `Json::get_error_description` returns a readable message for each value.
enum JsonParseError {
    /// No error.
    None = 0,
    /// Expected a comma, or a closing `}` or `]` to end an object or array.
    ExpectedCommaOrClosingBracket = 1,
    /// A colon between a name and its value is missing.
    ExpectedColon = 2,
    /// A string did not start with `"`.
    ExpectedOpeningQuote = 3,
    /// A string holds an invalid escape sequence.
    InvalidStringEscapeSequence = 4,
    /// A number is malformed.
    InvalidNumberFormat = 5,
    /// A value is invalid.
    InvalidValue = 6,
    /// The input ended before an object or array was complete.
    PrematureEndOfBuffer = 7,
    /// A string is malformed.
    InvalidString = 8,
    /// An allocation size did not fit in a usize.
    AllocatorFailed = 9,
    /// The input has extra characters after the value.
    UnexpectedTrailingCharacters = 10,
    /// Any other error.
    Unknown = 11,
    /// The input is nested deeper than the parser allows.
    TooDeep = 12,
}

/// A JSON number, kept as the text it was written with.
struct JsonNumber {
    /// The number as ASCII text.
    number: *const char,
    /// The length of `number` in bytes.
    number_size: usize,
}

/// One name and value in a `JsonObject`.
struct JsonObjectElement {
    /// The name of the element.
    name: *String,
    /// The value of the element.
    value: *JsonValue,
    /// The next element, or null for the last one.
    next: *JsonObjectElement,
}

/// A JSON object, held as a linked list of elements.
struct JsonObject {
    /// The first element, or null if the object is empty.
    start: *JsonObjectElement,
    /// The number of elements.
    length: usize,
}

/// One value in a `JsonArray`.
struct JsonArrayElement {
    /// The value of the element.
    value: *JsonValue,
    /// The next element, or null for the last one.
    next: *JsonArrayElement,
}

/// A JSON array, held as a linked list of elements.
struct JsonArray {
    /// The first element, or null if the array is empty.
    start: *JsonArrayElement,
    /// The number of elements.
    length: usize,
}

/// A JSON value.
///
/// `Json::parse_with_flags` returns the root value. Read `JsonValue.type` to see what it holds.
struct JsonValue {
    /// A pointer to a flowi `String`, a `JsonNumber`, `JsonObject` or `JsonArray`, as `JsonValue.type` says.
    ///
    /// It is null for `JsonType::True`, `JsonType::False` and `JsonType::Null`.
    payload: *void,
    /// The kind of the value.
    type: JsonType,
}

/// Where and why a parse failed.
///
/// `Json::parse_with_flags` fills it in when it returns null.
struct JsonParseResult {
    /// The reason the parse failed.
    error: JsonParseError,
    /// The byte offset of the error in the input, counting from 0.
    error_offset: usize,
    /// The line of the error, counting from 1.
    error_line_no: usize,
    /// The column of the error on its line, counting bytes from 1.
    error_row_no: usize,
}

/// A JSON parser that builds a tree of values in an arena.
///
/// Parse text with `Json::parse_with_flags`, read the tree with the `Json::get_string_prop` calls or by following
/// `JsonValue.payload`, and write it out again with `Json::write_pretty`.
api Json {
    /// Parses `src` and returns the root value, or null if it is not valid.
    ///
    /// `flags_bitset` 0 parses strict JSON and 1 also accepts JSON5. The tree is allocated from `arena`. If
    /// `result` is not null it receives the error when the parse fails. On failure the parse leaves nothing in `arena`.
    [manual] parse_with_flags(arena: *Arena, src: String, flags_bitset: usize, result: *JsonParseResult) -> *JsonValue
    /// Writes `value` as indented JSON text allocated from `arena`.
    ///
    /// `indent` and `newline` may be null, which uses two spaces and `\n`. Returns an empty string if `value` is null
    /// or cannot be written.
    [manual] write_pretty(arena: *Arena, value: *const JsonValue, indent: *const char, newline: *const char) -> String
    /// Returns the text of a string value, or an empty string if `value` is not a string.
    [manual] value_as_string(value: *JsonValue) -> String
    /// Returns the object in `value`, or null if `value` is not an object.
    [manual] value_as_object(value: *JsonValue) -> *JsonObject
    /// Finds the property `key` in an object and returns its value, or null if there is none.
    ///
    /// Also returns null if `object` is not an object.
    [manual] find_property(object: *const JsonValue, key: String) -> *JsonValue
    /// Returns the string property `key`, or an empty string if it is missing or not a string.
    [manual] get_string_prop(object: *const JsonValue, key: String) -> String
    /// Returns the number property `key` as a `u32`, or 0 if it is missing, is not a number or is not a whole number
    /// that fits.
    [manual] get_u32_prop(object: *const JsonValue, key: String) -> u32
    /// Returns the number property `key` as an `f64`, or 0.0 if it is missing, not a number or cannot be read.
    [manual] get_f64_prop(object: *const JsonValue, key: String) -> f64
    /// Returns the object property `key`, or null if it is missing or not an object.
    [manual] get_object_prop(object: *const JsonValue, key: String) -> *JsonValue
    /// Returns the array property `key`, or null if it is missing or not an array.
    [manual] get_array_prop(object: *const JsonValue, key: String) -> *JsonArray
    /// Returns a readable message for `error`.
    [manual] get_error_description(error: JsonParseError) -> String
}
