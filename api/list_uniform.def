/// Options for `ListUniform::begin`.
#[attributes(Copy)]
struct ListUniformOpts {
    /// The height of every row, in logical pixels (0 uses 32).
    ///
    /// The list does not size the rows, so give each row's content this height.
    height_hint: f32,
    /// The space between rows, in logical pixels (0 uses 8).
    gap: f32,
    /// The index of a row to scroll to this frame, or -1 to leave the scroll position alone.
    ///
    /// The list eases toward the row and places it a third of the way down the view. 0 scrolls to the first
    /// row, so set -1 when you do not want to scroll.
    scroll_to: i32,
    /// When the scrollbar is shown (`ScrollbarDisplayMode::Never` by default). The mouse wheel always scrolls.
    scrollbar_mode: ScrollbarDisplayMode,
}

/// The rows to draw this frame.
///
/// This is returned by `ListUniform::begin`. Draw the rows from `start` up to, and not including, `end`.
#[attributes(Copy)]
struct ListUniformRange {
    /// The index of the first row to draw (inclusive).
    start: u32,
    /// The index after the last row to draw (exclusive).
    end: u32,
    /// The number of rows passed to `ListUniform::begin`.
    total: u32,
}

/// A scrolling list of same-height rows, addressed by index.
///
/// Each frame, call `ListUniform::begin` with the number of rows. For each index in the range it returns, call
/// `ListUniform::item_begin`, draw the row, and call `ListUniform::item_end`. Then call `ListUniform::end`.
///
/// Only the rows on screen are drawn. This list only scrolls: for selection, keyboard navigation and row
/// dragging, use `List::begin`.
#[frame_context]
api ListUniform {
    /// Starts a list of `total_count` rows and returns the range of rows to draw.
    ///
    /// The scroll position is kept under `id`, so use the same `id` every frame.
    begin(id: String, total_count: u32, opts: ListUniformOpts) -> ListUniformRange
    /// Starts the row at `index`.
    item_begin(index: u32)
    /// Ends the row started with `ListUniform::item_begin`.
    item_end()
    /// Ends the list.
    end()
}
