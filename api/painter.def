/// How the two ends of an open stroke are finished.
enum StrokeCap {
    /// Cut square at the end point. On an arc this keeps sector pie edges clean.
    Butt = 0,
    /// Round the end with a half disc of the stroke width.
    Round = 1,
}

/// An outline: its width and color, plus an optional dash pattern and end cap. A zeroed dash and cap give a
/// solid, butt-capped stroke, so `{ width, color }` is the common case.
/// Closed outlines (rect, circle, diamond) grow inward from the shape's edge, and an arc grows inward from
/// its radius; a line or polyline is centered on its points.
#[attributes(Copy)]
struct Stroke {
    /// stroke width in logical (authoring) px
    width: f32,
    /// stroke color
    color: Color,
    /// dash pattern; drawn by the rect and circle outlines, every other shape strokes solid
    dash: StrokeStyle,
    /// end cap; read by Painter::arc. Lines and polylines always have round caps and joins
    cap: StrokeCap,
}

/// Polyline draw flags, combined with bitwise OR.
#[attributes(bitflags)]
enum PolylineFlags {
    /// Fill between the curve and baseline_y with fill_color.
    filled = 1,
    /// Add a last->first closing segment.
    closed = 2,
}

/// One polyline vertex. intensity is always present (1.0 = plain): it modulates the stroke alpha, lerped
/// along segments, and scales the fill alpha when the polyline is FILLED.
#[attributes(Copy)]
struct PolyPoint {
    /// x position in logical (authoring) space
    x: f32,
    /// y position in logical (authoring) space
    y: f32,
    /// per-vertex stroke/fill alpha multiplier (1.0 = plain)
    intensity: f32,
}

/// One bar of a bar set, in logical (authoring) space. Height extends from the set's shared baseline upward;
/// a negative h draws downward. Width is per-bar so log-spaced spectrum bins fit without a stride rule.
#[attributes(Copy)]
struct Bar {
    /// left edge
    x: f32,
    /// bar width
    w: f32,
    /// height from the baseline; negative draws downward
    h: f32,
}

/// Decorative effect kind. Drop-shadow and glow share one shape - a glow is a centered, additive shadow.
/// Packed to one byte so Effect can hold it typed without growing the record.
#[attributes(packed)]
enum EffectKind {
    /// No effect.
    None = 0,
    /// A blurred copy of the shape, offset by (off_x, off_y) and drawn behind it.
    DropShadow = 1,
    /// A blurred copy of the shape, centered on it and blended additively.
    Glow = 2,
}

/// A decorative shadow or glow attached to a painter draw. Appearance only - it never changes geometry or
/// hit-testing, and a backend that does not support effects skips it (today: the software backend, and text
/// runs on every backend). A zeroed effect is EffectKind::None, i.e. no effect.
/// Offsets and blur are logical (authoring) px and scale like every other painter length.
#[attributes(Copy)]
struct Effect {
    /// Which effect to draw.
    kind: EffectKind,
    /// Shadow / glow color.
    color: Color,
    /// Horizontal shadow offset; ignored by Glow, which is centered.
    off_x: f32,
    /// Vertical shadow offset; ignored by Glow, which is centered.
    off_y: f32,
    /// Blur radius; 0 draws a hard-edged copy.
    blur: f32,
}

/// Fill styling for one rectangle: per-corner radius and per-corner colors, the two things the fill-rect
/// primitive can do at once. A solid fill is four equal corner colors (corner = {c, c, c, c}); differing
/// colors interpolate bilinearly across the quad. There is deliberately no single-color field: a zeroed
/// Color is legitimately transparent, so a fallback could not tell "unset" from "invisible".
#[attributes(Copy)]
struct RectConfig {
    /// Per-corner radius in logical (authoring) px; zeroed = square corners.
    radius: CornerRadius,
    /// Corner colors in TL, TR, BL, BR order.
    corner: [Color; 4],
}

/// One solid filled rectangle of a Painter::rects batch: top-left (x, y), size (w, h), in logical (authoring)
/// space, filled with color.
#[attributes(Copy)]
struct ColoredRect {
    /// left edge
    x: f32,
    /// top edge
    y: f32,
    /// width
    w: f32,
    /// height
    h: f32,
    /// fill color
    color: Color,
}

/// The four corner colors of a Painter::gradient_rect, interpolated bilinearly across the rectangle.
#[attributes(Copy)]
struct CornerColors {
    /// top-left corner
    top_left: Color,
    /// top-right corner
    top_right: Color,
    /// bottom-left corner
    bottom_left: Color,
    /// bottom-right corner
    bottom_right: Color,
}

/// How a Painter::polyline is stroked and filled.
#[attributes(Copy)]
struct PolylineStyle {
    /// stroke width and color; caps and joins are always round, and the dash pattern is not drawn
    stroke: Stroke,
    /// filling and closing (empty = an open stroke)
    flags: PolylineFlags,
    /// fill color, used when flags has filled
    fill_color: Color,
    /// y the fill extends to, used when flags has filled
    baseline_y: f32,
}

/// A source rectangle of an image drawn into a destination rectangle.
#[attributes(Copy)]
struct ImageSub {
    /// destination left edge, in logical (authoring) space
    dx: f32,
    /// destination top edge
    dy: f32,
    /// destination width; non-positive uses the source width
    dw: f32,
    /// destination height; non-positive uses the source height
    dh: f32,
    /// source left edge, in source image pixels
    sx: f32,
    /// source top edge
    sy: f32,
    /// source width
    sw: f32,
    /// source height
    sh: f32,
    /// the `ImageHandle` from Image::load
    image: ImageHandle,
    /// multiplicatively tints color images and colorizes alpha atlases
    color: Color,
}

/// Custom-drawing primitives: the painter's shape, line, text, and image commands. Call these to draw
/// directly into the current frame.
#[frame_context]
api Painter {
    /// Set the effect every later painter call in the current element carries - effects are group-shaped, so
    /// one shadow covers a cluster of draws instead of being repeated per primitive. A zeroed effect
    /// (kind = EffectKind::None) clears it. The effect is scoped to the element it was set in: it clears
    /// when that element's layout scope closes and at the start of each frame, so it can never reach a
    /// sibling, a nested child, or a later frame. Text draws ignore it - no backend resolves an effect on
    /// a text run.
    set_effect(effect: Effect)
    /// Draw a filled rectangle: top-left (x, y), size (w, h), in logical (authoring) space.
    rect(x: f32, y: f32, w: f32, h: f32, color: Color)
    /// Draw a batch of solid filled rectangles in one call - dense visuals such as a scope waveform's
    /// one-rectangle-per-pixel columns. The result is exactly that of calling rect() for each entry in
    /// order: call order (later entries paint over earlier ones), alpha compositing, clipping, UI scaling,
    /// the current effect and Canvas z-order all behave as in the scalar loop, on every render backend.
    /// An empty batch draws nothing.
    rects(rects: [*const ColoredRect])
    /// Draw a filled rounded rectangle: top-left (x, y), size (w, h), corner radius, all in logical space.
    rect_rounded(x: f32, y: f32, w: f32, h: f32, radius: f32, color: Color)
    /// Draw the outline of a rectangle: top-left (x, y), size (w, h), in logical space. The stroke lies
    /// inside the rectangle and can be dashed. The current effect does not apply to it.
    rect_stroke(x: f32, y: f32, w: f32, h: f32, stroke: Stroke)
    /// Draw the outline of a rounded rectangle; radius is the outer corner radius. Otherwise as
    /// Painter::rect_stroke.
    rect_rounded_stroke(x: f32, y: f32, w: f32, h: f32, radius: f32, stroke: Stroke)
    /// Draw a filled rectangle with a four-corner color gradient (bilinear): top-left (x, y), size (w, h),
    /// in logical space.
    gradient_rect(x: f32, y: f32, w: f32, h: f32, colors: CornerColors)
    /// Draw a filled rectangle styled by config: per-corner radius and a per-corner color gradient in one
    /// draw, which is what rect_rounded (solid only) and gradient_rect (square only) cannot express
    /// together. Top-left (x, y), size (w, h), in logical space. Each radius clamps to half the smaller
    /// dimension, so an over-large radius gives a pill rather than an artifact.
    rect_styled(x: f32, y: f32, w: f32, h: f32, config: RectConfig)
    /// Draw a crisp 1px horizontal hairline of length from (x, y). Device-pixel snapped, so it stays sharp at
    /// fractional scroll/zoom.
    hline(x: f32, y: f32, length: f32, color: Color)
    /// Draw a crisp 1px vertical hairline of length from (x, y). Device-pixel snapped, so it stays sharp at
    /// fractional scroll/zoom.
    vline(x: f32, y: f32, length: f32, color: Color)
    /// Draw a straight line from (x0, y0) to (x1, y1), centered on the two points, with round caps. For a
    /// crisp 1px horizontal or vertical rule use hline or vline instead.
    line(x0: f32, y0: f32, x1: f32, y1: f32, stroke: Stroke)
    /// Draw text with font (FontId::INVALID = active font) in color, top-left at (x, y).
    text(x: f32, y: f32, text: String, font: FontId, color: Color)
    /// Draw single-line text styled by style (font, fractional pixel size, letter spacing; zero fields
    /// fall back: font_id 0 = active font, font_size 0 = the font's default size), in color, top-left
    /// at (x, y). Sizes quantize internally to quarter-pixel steps - the same quantizer Text::measure
    /// uses, so a measured run matches what gets drawn.
    text_styled(x: f32, y: f32, text: String, style: TextStyle, color: Color)
    /// Draw image image into the rect at top-left (x, y), size (w, h). image is the
    /// `ImageHandle` from Image::load. color multiplicatively tints the image - pass white
    /// (255, 255, 255, 255) for no tint. Returns false (and draws nothing) until the image is ready.
    image(x: f32, y: f32, w: f32, h: f32, image: ImageHandle, color: Color) -> bool
    /// Draw a filled circle: center (cx, cy) and radius, in logical space.
    circle(cx: f32, cy: f32, radius: f32, color: Color)
    /// Draw the outline of a circle. The stroke lies inside radius and can be dashed; the dash period is
    /// rescaled slightly so a whole number of dashes closes the ring, with no stub where the pattern wraps.
    circle_stroke(cx: f32, cy: f32, radius: f32, stroke: Stroke)
    /// Draw a filled circle and its outline as one shape. Prefer this to a circle call followed by a
    /// circle_stroke call: the two are antialiased together, so no fill color shows at the outer edge.
    circle_bordered(cx: f32, cy: f32, radius: f32, color: Color, border: Stroke)
    /// Draw a filled diamond: center (cx, cy), horizontal half-extent rx and vertical half-extent ry.
    diamond(cx: f32, cy: f32, rx: f32, ry: f32, color: Color)
    /// Draw the outline of a diamond. The stroke lies inside the diamond and is always solid.
    diamond_stroke(cx: f32, cy: f32, rx: f32, ry: f32, stroke: Stroke)
    /// Draw a filled diamond and its outline as one shape, antialiased together like
    /// Painter::circle_bordered.
    diamond_bordered(cx: f32, cy: f32, rx: f32, ry: f32, color: Color, border: Stroke)
    /// Draw a stroked arc or ring around (cx, cy). Angles are radians: 0 is 12 o'clock and a positive
    /// sweep runs clockwise. The stroke grows inward from radius, so a stroke width of radius or more
    /// gives a filled sector. stroke.cap picks butt or round ends.
    arc(cx: f32, cy: f32, radius: f32, start_angle: f32, sweep: f32, stroke: Stroke)
    /// Draw a polyline. points are
    /// vertices in logical (authoring) space; each vertex's intensity modulates stroke alpha (lerped along
    /// segments) and scales fill alpha. style carries the stroke and the optional fill.
    polyline(points: [*const PolyPoint], style: PolylineStyle)
    /// Draw a row of bars off the shared baseline baseline_y - meters, spectrum analyzers, step sequencers.
    /// The whole row is one draw, which is what a bar row buys over a rect per bar. Each bar carries its own
    /// x, width, and height, all in logical (authoring) space; a negative height draws downward. This is an
    /// optional-tier primitive: a backend may skip it (today the software backend does).
    bars(baseline_y: f32, bars: [*const Bar], color: Color)
    /// Draw a source rectangle of an image, in source image pixels, into a destination rectangle in
    /// logical (authoring) space. A non-positive destination width or height uses the source width or
    /// height. Returns false (and draws nothing) until the image is ready or when the source rect is
    /// empty.
    image_sub(sub: ImageSub) -> bool
}
