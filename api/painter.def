/// How the ends of an arc stroke are finished.
enum StrokeCap {
    /// Cut square at the end point.
    Butt = 0,
    /// Rounded with a half disc as wide as the stroke.
    Round = 1,
}

/// The outline of a shape or line: its width, color, dash pattern and end cap.
///
/// A zeroed `dash` and `cap` give a solid stroke with butt caps, so `{ width, color }` is the common case.
///
/// A closed outline (rectangle, circle or diamond) grows inward from the edge of the shape. An arc grows inward
/// from its radius. A line or polyline is centered on its points.
#[attributes(Copy)]
struct Stroke {
    /// The stroke width, in logical pixels.
    width: f32,
    /// The stroke color.
    color: Color,
    /// The dash pattern.
    ///
    /// Only the outlines of rectangles and circles use it, and only on the GPU backend. Everything else is solid.
    dash: StrokeStyle,
    /// How the ends of an arc are finished.
    ///
    /// Only `Painter::arc` reads it. `Painter::line` and `Painter::polyline` always use round caps and joins.
    cap: StrokeCap,
}

/// How a polyline is filled and closed, combined with bitwise OR.
#[attributes(bitflags)]
enum PolylineFlags {
    /// Fill between the curve and `PolylineStyle.baseline_y` with `PolylineStyle.fill_color`.
    filled = 1,
    /// Add a segment from the last point back to the first.
    closed = 2,
}

/// One vertex of a polyline.
#[attributes(Copy)]
struct PolyPoint {
    /// The x position, in logical pixels.
    x: f32,
    /// The y position, in logical pixels.
    y: f32,
    /// A multiplier for the alpha of the stroke and of the fill at this vertex (1.0 leaves it unchanged).
    ///
    /// The stroke alpha is interpolated along each segment.
    intensity: f32,
}

/// One bar of a `Painter::bars` row.
///
/// The bar spans from the baseline of the row to `h`. Every bar has its own width.
#[attributes(Copy)]
struct Bar {
    /// The left edge, in logical pixels.
    x: f32,
    /// The width, in logical pixels.
    w: f32,
    /// The height above the baseline, in logical pixels. A negative height draws downward.
    h: f32,
}

/// The kind of a decorative effect.
#[attributes(packed)]
enum EffectKind {
    /// No effect.
    None = 0,
    /// A blurred copy of the shape, offset by `Effect.off_x` and `Effect.off_y` and drawn behind it.
    DropShadow = 1,
    /// A blurred copy of the shape, centered on it and blended additively.
    Glow = 2,
}

/// A shadow or glow that `Painter::set_effect` attaches to later draws.
///
/// An effect only changes how a draw looks. It never changes geometry or hit-testing. Only the GPU backend draws
/// it, and text is never drawn with an effect. A zeroed effect has the kind `EffectKind::None`.
#[attributes(Copy)]
struct Effect {
    /// The kind of effect.
    kind: EffectKind,
    /// The color of the shadow or glow.
    color: Color,
    /// The horizontal offset of a shadow, in logical pixels. A glow ignores it.
    off_x: f32,
    /// The vertical offset of a shadow, in logical pixels. A glow ignores it.
    off_y: f32,
    /// The blur radius, in logical pixels (0 draws a hard-edged copy).
    blur: f32,
}

/// The fill of a rectangle: a radius and a color for each corner.
///
/// This is passed to `Painter::rect_styled`. Four equal corner colors give a solid fill. Different colors are
/// interpolated across the rectangle.
#[attributes(Copy)]
struct RectConfig {
    /// The radius of each corner, in logical pixels (0 gives a square corner).
    radius: CornerRadius,
    /// The color of each corner, in the order top-left, top-right, bottom-left, bottom-right.
    corner: [Color; 4],
}

/// One solid rectangle of a `Painter::rects` batch.
#[attributes(Copy)]
struct ColoredRect {
    /// The left edge, in logical pixels.
    x: f32,
    /// The top edge, in logical pixels.
    y: f32,
    /// The width, in logical pixels.
    w: f32,
    /// The height, in logical pixels.
    h: f32,
    /// The fill color.
    color: Color,
}

/// The corner colors of a gradient rectangle.
///
/// This is passed to `Painter::gradient_rect`. The colors are interpolated across the rectangle.
#[attributes(Copy)]
struct CornerColors {
    /// The color of the top-left corner.
    top_left: Color,
    /// The color of the top-right corner.
    top_right: Color,
    /// The color of the bottom-left corner.
    bottom_left: Color,
    /// The color of the bottom-right corner.
    bottom_right: Color,
}

/// How a polyline is stroked and filled.
///
/// This is passed to `Painter::polyline`.
#[attributes(Copy)]
struct PolylineStyle {
    /// The width and color of the line.
    ///
    /// Caps and joins are always round, and the dash pattern is not drawn.
    stroke: Stroke,
    /// How to fill or close the polyline (no flags draws an open stroke).
    flags: PolylineFlags,
    /// The fill color. It is used when `flags` has `PolylineFlags::filled`.
    fill_color: Color,
    /// The y position the fill extends to, in logical pixels. It is used when `flags` has `PolylineFlags::filled`.
    baseline_y: f32,
}

/// A part of an image drawn into a destination rectangle.
///
/// This is passed to `Painter::image_sub`.
#[attributes(Copy)]
struct ImageSub {
    /// The left edge of the destination, in logical pixels.
    dx: f32,
    /// The top edge of the destination, in logical pixels.
    dy: f32,
    /// The width of the destination, in logical pixels (0 or less uses the width of the source).
    dw: f32,
    /// The height of the destination, in logical pixels (0 or less uses the height of the source).
    dh: f32,
    /// The left edge of the source, in image pixels.
    sx: f32,
    /// The top edge of the source, in image pixels.
    sy: f32,
    /// The width of the source, in image pixels.
    sw: f32,
    /// The height of the source, in image pixels.
    sh: f32,
    /// The image to draw, from `Image::load`.
    image: ImageHandle,
    /// The tint, multiplied with the image. Pass white (255, 255, 255, 255) for no tint.
    color: Color,
}

/// Drawing commands for custom shapes, lines, text and images.
///
/// Call these while a layout element is open. They draw into that element, and do nothing outside one. All
/// positions and sizes are in logical pixels, relative to the element.
///
/// The software backend draws only rectangles, outlines, text and images. It skips circles, diamonds, arcs,
/// lines, polylines and bars.
#[frame_context]
api Painter {
    /// Sets the effect that later draws in the current element carry.
    ///
    /// One shadow can then cover a group of draws. A zeroed effect clears it. The effect ends when the element
    /// ends, so it never reaches a sibling, a child or the next frame. Text ignores it.
    set_effect(effect: Effect)
    /// Draws a filled rectangle with its top-left corner at (`x`, `y`).
    rect(x: f32, y: f32, w: f32, h: f32, color: Color)
    /// Draws a batch of filled rectangles in one call.
    ///
    /// The result is the same as calling `Painter::rect` for each entry in order, so later entries paint over
    /// earlier ones. An empty batch draws nothing.
    rects(rects: [*const ColoredRect])
    /// Draws a filled rectangle with rounded corners of the same `radius`.
    rect_rounded(x: f32, y: f32, w: f32, h: f32, radius: f32, color: Color)
    /// Draws the outline of a rectangle.
    ///
    /// The stroke lies inside the rectangle and can be dashed. A stroke wider than half the shorter side fills it.
    rect_stroke(x: f32, y: f32, w: f32, h: f32, stroke: Stroke)
    /// Draws the outline of a rectangle with rounded corners.
    ///
    /// `radius` is the outer radius of the corners. It works like `Painter::rect_stroke` otherwise.
    rect_rounded_stroke(x: f32, y: f32, w: f32, h: f32, radius: f32, stroke: Stroke)
    /// Draws a filled rectangle with a different color in each corner.
    gradient_rect(x: f32, y: f32, w: f32, h: f32, colors: CornerColors)
    /// Draws a filled rectangle with a radius and a color for each corner.
    ///
    /// Use it for a rounded rectangle with a gradient, which `Painter::rect_rounded` and `Painter::gradient_rect`
    /// cannot draw. A radius larger than half the shorter side is clamped to it, which gives a pill.
    rect_styled(x: f32, y: f32, w: f32, h: f32, config: RectConfig)
    /// Draws a horizontal line of `length` that is one logical pixel thick.
    ///
    /// The thickness is rounded to whole device pixels (at least one) and the line is aligned to them, so it
    /// stays sharp when the view is scrolled or zoomed by a fraction.
    hline(x: f32, y: f32, length: f32, color: Color)
    /// Draws a vertical line of `length` that is one logical pixel thick.
    ///
    /// The thickness is rounded to whole device pixels (at least one) and the line is aligned to them, so it
    /// stays sharp when the view is scrolled or zoomed by a fraction.
    vline(x: f32, y: f32, length: f32, color: Color)
    /// Draws a straight line from (`x0`, `y0`) to (`x1`, `y1`).
    ///
    /// The line is centered on the two points and has round caps that reach half the stroke width past each
    /// end. Equal points draw a dot as wide as the stroke. For a sharp one pixel line, use `Painter::hline` or
    /// `Painter::vline`.
    line(x0: f32, y0: f32, x1: f32, y1: f32, stroke: Stroke)
    /// Draws `text` with its top-left corner at (`x`, `y`).
    ///
    /// A `font` of 0 uses the active font.
    text(x: f32, y: f32, text: String, font: FontId, color: Color)
    /// Draws a single line of `text` in the given style, with its top-left corner at (`x`, `y`).
    ///
    /// Sizes are rounded to quarter pixels in the same way as in `Text::measure`, so a measured run matches the
    /// drawn one.
    text_styled(x: f32, y: f32, text: String, style: TextStyle, color: Color)
    /// Draws an image into the rectangle at (`x`, `y`) and returns whether it was drawn.
    ///
    /// `image` is the handle from `Image::load`. `color` is multiplied with the image, so pass white
    /// (255, 255, 255, 255) for no tint. A `w` or `h` of 0 or less uses the width or height of the image. It
    /// returns false and draws nothing until the image is ready.
    image(x: f32, y: f32, w: f32, h: f32, image: ImageHandle, color: Color) -> bool
    /// Draws a filled circle.
    circle(cx: f32, cy: f32, radius: f32, color: Color)
    /// Draws the outline of a circle.
    ///
    /// The stroke lies inside `radius` and can be dashed. The dash period is adjusted slightly so that a whole
    /// number of dashes closes the ring.
    circle_stroke(cx: f32, cy: f32, radius: f32, stroke: Stroke)
    /// Draws a filled circle with an outline.
    ///
    /// Use it instead of `Painter::circle` followed by `Painter::circle_stroke`. The two are drawn as one
    /// shape, so no fill color shows at the outer edge.
    circle_bordered(cx: f32, cy: f32, radius: f32, color: Color, border: Stroke)
    /// Draws a filled diamond with the half-width `rx` and the half-height `ry`.
    diamond(cx: f32, cy: f32, rx: f32, ry: f32, color: Color)
    /// Draws the outline of a diamond.
    ///
    /// The stroke lies inside the diamond and is always solid.
    diamond_stroke(cx: f32, cy: f32, rx: f32, ry: f32, stroke: Stroke)
    /// Draws a filled diamond with an outline, as one shape like `Painter::circle_bordered`.
    diamond_bordered(cx: f32, cy: f32, rx: f32, ry: f32, color: Color, border: Stroke)
    /// Draws an arc, or a full ring, around (`cx`, `cy`).
    ///
    /// The angles are in radians. 0 is 12 o'clock and a positive `sweep` runs clockwise. The stroke grows
    /// inward from `radius`, so a stroke width of `radius` or more gives a filled sector. `Stroke.cap` sets
    /// the ends.
    arc(cx: f32, cy: f32, radius: f32, start_angle: f32, sweep: f32, stroke: Stroke)
    /// Draws a line through `points`, with an optional fill.
    ///
    /// `style` holds the stroke and the fill. The `PolyPoint.intensity` of each point scales the alpha of the
    /// stroke and of the fill.
    polyline(points: [*const PolyPoint], style: PolylineStyle)
    /// Draws a row of bars that start at `baseline_y`, in one draw.
    ///
    /// Use it for meters, spectrum analyzers and step sequencers. A backend may skip it, and the software backend
    /// does.
    bars(baseline_y: f32, bars: [*const Bar], color: Color)
    /// Draws part of an image into a destination rectangle and returns whether it was drawn.
    ///
    /// It returns false and draws nothing until the image is ready, or when the source rectangle is empty.
    image_sub(sub: ImageSub) -> bool
}
